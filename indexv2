<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PACE Health — OT Training Program · Module 1</title>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
<style>

:root {
  --green:       #0F5C4D;
  --green-mid:   #1A7A68;
  --green-light: #2A9D8B;
  --green-pale:  #E4F2EF;
  --green-xpale: #F0F8F6;
  --sage:        #7FB5AB;
  --gold:        #D4A843;
  --gold-pale:   #FBF3E0;
  --navy:        #1B2D3F;
  --slate:       #4A5568;
  --body:        #374151;
  --border:      #D8EAE6;
  --bg:          #F7F8F5;
  --white:       #FFFFFF;
  --card-shadow: 0 2px 12px rgba(15,92,77,0.08);
  --card-shadow-hover: 0 6px 24px rgba(15,92,77,0.14);
  --r:           14px;
  --r-sm:        8px;
}

* { margin:0; padding:0; box-sizing:border-box; }

html { scroll-behavior:smooth; }

body {
  font-family:'Outfit',sans-serif;
  background:var(--bg);
  color:var(--body);
  font-size:15px;
  line-height:1.65;
}

/* ── TOP NAV ── */
.top-nav {
  position:sticky; top:0; z-index:100;
  background:var(--white);
  border-bottom:1px solid var(--border);
  display:flex; align-items:center; justify-content:space-between;
  padding:0 32px;
  height:56px;
  box-shadow:0 2px 8px rgba(0,0,0,0.06);
}
.nav-brand {
  display:flex; align-items:center; gap:10px;
}
.nav-logo-box {
  width:32px; height:32px; border-radius:8px;
  background:var(--green);
  display:flex; align-items:center; justify-content:center;
  font-weight:800; font-size:12px; color:#fff; letter-spacing:0.05em;
}
.nav-title {
  font-weight:700; font-size:13px; color:var(--navy);
  letter-spacing:0.01em;
}
.nav-sub {
  font-size:11px; color:var(--slate); margin-top:1px;
}
.nav-workshops {
  display:flex; gap:4px; align-items:center;
}
.nav-ws {
  font-size:11px; font-weight:500; color:var(--slate);
  padding:5px 10px; border-radius:20px; cursor:pointer;
  transition:all 0.2s; text-decoration:none;
  border:1px solid transparent;
}
.nav-ws:hover { background:var(--green-pale); color:var(--green); }
.nav-ws.active {
  background:var(--green); color:#fff;
  border-color:var(--green);
}

/* ── HERO COVER ── */
.hero {
  background:var(--navy);
  padding:80px 64px 0;
  overflow:hidden;
  position:relative;
  min-height:520px;
  display:flex; flex-direction:column; justify-content:flex-end;
}
.hero-bg-circles {
  position:absolute; inset:0; overflow:hidden; pointer-events:none;
}
.hero-circle {
  position:absolute; border-radius:50%;
  background:rgba(42,157,139,0.12);
}
.hero-badge {
  display:inline-flex; align-items:center; gap:8px;
  background:rgba(212,168,67,0.2);
  border:1px solid rgba(212,168,67,0.4);
  border-radius:20px; padding:5px 14px;
  font-size:11px; font-weight:600; color:var(--gold);
  letter-spacing:0.08em; text-transform:uppercase;
  margin-bottom:24px; width:fit-content;
}
.hero-title {
  font-family:'Outfit',sans-serif;
  font-size:56px; font-weight:800; line-height:1.05;
  color:#fff; margin-bottom:16px; max-width:640px;
}
.hero-title span { color:var(--gold); }
.hero-desc {
  font-size:15px; color:rgba(255,255,255,0.65);
  max-width:540px; line-height:1.7; margin-bottom:40px;
}
.hero-meta {
  display:flex; gap:32px; margin-bottom:48px;
}
.hero-meta-item label {
  display:block; font-size:10px; letter-spacing:0.12em;
  text-transform:uppercase; color:rgba(255,255,255,0.4); margin-bottom:4px;
}
.hero-meta-item span {
  font-size:13px; font-weight:500; color:rgba(255,255,255,0.85);
}
.hero-workshop-grid {
  display:grid; grid-template-columns:repeat(6,1fr); gap:1px;
  background:rgba(255,255,255,0.08);
  border-top:1px solid rgba(255,255,255,0.1);
  margin:0 -64px;
}
.hero-ws-tile {
  padding:20px 20px 24px;
  background:rgba(15,20,30,0.3);
  backdrop-filter:blur(4px);
  cursor:pointer;
  transition:background 0.2s;
  text-decoration:none;
}
.hero-ws-tile:hover { background:rgba(42,157,139,0.2); }
.hero-ws-num {
  font-family:'Lora',serif; font-size:28px; font-weight:400;
  color:var(--green-light); margin-bottom:6px; line-height:1;
}
.hero-ws-name {
  font-size:11px; color:rgba(255,255,255,0.55); line-height:1.4;
}

/* ── MODULE OVERVIEW PAGE ── */
.section-page {
  max-width:1080px; margin:0 auto; padding:64px 40px;
}
.section-page + .section-page {
  border-top:1px solid var(--border);
}

/* ── WORKSHOP HEADER ── */
.ws-header-card {
  border-radius:var(--r);
  overflow:hidden;
  margin-bottom:40px;
  display:grid; grid-template-columns:1fr auto;
  align-items:stretch;
  box-shadow:var(--card-shadow);
}
.ws-header-left {
  background:var(--green);
  padding:36px 40px;
  position:relative; overflow:hidden;
}
.ws-header-left::after {
  content:'';
  position:absolute; right:-40px; top:-40px;
  width:180px; height:180px; border-radius:50%;
  background:rgba(255,255,255,0.05);
  pointer-events:none;
}
.ws-num-badge {
  font-size:10px; font-weight:700; letter-spacing:0.14em;
  text-transform:uppercase; color:rgba(255,255,255,0.5);
  margin-bottom:12px;
}
.ws-header-title {
  font-size:28px; font-weight:700; color:#fff;
  line-height:1.15; margin-bottom:12px;
}
.ws-header-purpose {
  font-size:13.5px; color:rgba(255,255,255,0.72);
  line-height:1.65; max-width:520px;
}
.ws-header-right {
  background:var(--green-pale);
  padding:28px 32px;
  min-width:240px;
  display:flex; flex-direction:column; justify-content:center; gap:14px;
}
.ws-meta-row {
  display:flex; align-items:center; gap:10px;
}
.ws-meta-icon {
  width:28px; height:28px; border-radius:6px;
  background:var(--white); display:flex; align-items:center;
  justify-content:center; font-size:13px; flex-shrink:0;
  box-shadow:0 1px 4px rgba(0,0,0,0.08);
}
.ws-meta-label { font-size:10px; color:var(--slate); }
.ws-meta-val { font-size:13px; font-weight:600; color:var(--navy); }

/* ── SECTION LABEL ── */
.sec-label {
  display:flex; align-items:center; gap:10px;
  margin-bottom:20px; margin-top:40px;
}
.sec-label-num {
  width:26px; height:26px; border-radius:50%;
  background:var(--green); color:#fff;
  font-size:11px; font-weight:700;
  display:flex; align-items:center; justify-content:center;
  flex-shrink:0;
}
.sec-label-text {
  font-size:12px; font-weight:700; letter-spacing:0.1em;
  text-transform:uppercase; color:var(--green);
}
.sec-label-bar {
  flex:1; height:1px; background:var(--border);
}

/* ── OBJECTIVES BOX ── */
.objectives-box {
  background:var(--navy);
  border-radius:var(--r);
  padding:28px 32px;
  margin-bottom:32px;
}
.objectives-box h3 {
  font-size:11px; font-weight:700; letter-spacing:0.12em;
  text-transform:uppercase; color:var(--gold);
  margin-bottom:16px;
}
.objectives-grid {
  display:grid; grid-template-columns:1fr 1fr; gap:8px;
}
.obj-item {
  display:flex; align-items:flex-start; gap:9px;
  font-size:13px; color:rgba(255,255,255,0.8); line-height:1.5;
}
.obj-dot {
  width:6px; height:6px; border-radius:50%;
  background:var(--green-light); flex-shrink:0; margin-top:5px;
}

/* ── CONTENT CARDS ── */
.card {
  background:var(--white);
  border-radius:var(--r);
  border:1px solid var(--border);
  padding:28px;
  box-shadow:var(--card-shadow);
  transition:box-shadow 0.2s;
}
.card:hover { box-shadow:var(--card-shadow-hover); }
.card-title {
  font-size:14px; font-weight:700; color:var(--navy);
  margin-bottom:12px; display:flex; align-items:center; gap:8px;
}
.card-icon {
  width:28px; height:28px; border-radius:7px;
  background:var(--green-pale);
  display:flex; align-items:center; justify-content:center;
  font-size:14px; flex-shrink:0;
}
.card-body { font-size:13px; color:var(--slate); line-height:1.65; }
.card-body li {
  list-style:none; display:flex; gap:8px; padding:3px 0;
}
.card-body li::before {
  content:'→'; color:var(--green-light); font-size:11px;
  flex-shrink:0; margin-top:2px;
}

.grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:20px; }
.grid-3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; }
.grid-4 { display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:14px; }

/* ── HIGHLIGHT / CALLOUT ── */
.callout {
  border-radius:var(--r-sm);
  padding:16px 20px;
  display:flex; gap:12px; align-items:flex-start;
}
.callout.teal { background:var(--green-pale); border-left:4px solid var(--green); }
.callout.gold { background:var(--gold-pale); border-left:4px solid var(--gold); }
.callout.navy { background:#EEF1F5; border-left:4px solid var(--navy); }
.callout-icon { font-size:18px; flex-shrink:0; margin-top:1px; }
.callout-content { font-size:13px; line-height:1.6; }
.callout-content strong { color:var(--navy); }
.callout.teal .callout-content { color:var(--green); }
.callout.gold .callout-content { color:#7A5010; }
.callout.navy .callout-content { color:var(--navy); }

/* ── DIAGRAM: BIOPSYCHOSOCIAL ── */
.bio-diagram {
  display:flex; align-items:center; justify-content:center;
  padding:32px; background:var(--white);
  border-radius:var(--r); border:1px solid var(--border);
  position:relative; min-height:240px;
}
.bio-circles {
  position:relative; width:280px; height:200px;
}
.bio-circle {
  position:absolute;
  width:150px; height:150px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  font-size:12px; font-weight:700; letter-spacing:0.05em;
  text-align:center; line-height:1.3;
}
.bio-circle.bio { background:rgba(15,92,77,0.15); color:var(--green); top:0; left:0; }
.bio-circle.psy { background:rgba(212,168,67,0.18); color:#7A5010; top:0; right:0; }
.bio-circle.soc { background:rgba(100,116,139,0.15); color:#334155; bottom:0; left:50%; transform:translateX(-50%); }
.bio-center {
  position:absolute; width:52px; height:52px; border-radius:50%;
  background:var(--green); color:#fff;
  display:flex; align-items:center; justify-content:center;
  font-size:9px; font-weight:700; text-align:center; line-height:1.3;
  top:50%; left:50%; transform:translate(-50%,-50%);
  box-shadow:0 2px 8px rgba(15,92,77,0.3);
}

/* ── DIAGRAM: STAGES FLOW ── */
.stages-flow {
  display:flex; align-items:center; gap:0; overflow-x:auto;
  padding:20px 0;
}
.stage-node {
  flex:1; display:flex; flex-direction:column; align-items:center; gap:8px;
  position:relative; min-width:90px;
}
.stage-node:not(:last-child)::after {
  content:'→';
  position:absolute; right:-10px; top:22px;
  color:var(--sage); font-size:16px; font-weight:300;
}
.stage-circle {
  width:44px; height:44px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  font-size:11px; font-weight:700; color:#fff;
  box-shadow:0 2px 8px rgba(0,0,0,0.1);
}
.stage-label {
  font-size:10.5px; font-weight:600; color:var(--navy);
  text-align:center; line-height:1.3;
}
.stage-desc {
  font-size:9.5px; color:var(--slate); text-align:center; line-height:1.4;
}

/* ── DIAGRAM: DECISION LINE ── */
.decision-line {
  background:var(--white); border-radius:var(--r);
  border:1px solid var(--border); padding:28px 32px;
}
.dl-track {
  position:relative; height:8px;
  background:linear-gradient(90deg, #FEE2E2 0%, #FEF3C7 50%, #D1FAE5 100%);
  border-radius:4px; margin:24px 0 32px;
}
.dl-marker {
  position:absolute; top:50%; transform:translateY(-50%);
  width:20px; height:20px; border-radius:50%;
  border:3px solid var(--white); box-shadow:0 0 0 2px currentColor;
}
.dl-labels {
  display:flex; justify-content:space-between;
  font-size:11px; font-weight:600;
}
.dl-not-ready { color:#DC2626; }
.dl-ready { color:#059669; }
.dl-zones {
  display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:16px;
}
.dl-zone {
  border-radius:var(--r-sm); padding:14px 16px;
  font-size:12.5px;
}
.dl-zone.left { background:#FFF1F1; }
.dl-zone.right { background:#ECFDF5; }
.dl-zone h4 { font-size:12px; font-weight:700; margin-bottom:8px; }
.dl-zone.left h4 { color:#DC2626; }
.dl-zone.right h4 { color:#059669; }
.dl-zone ul { list-style:none; }
.dl-zone li { font-size:12px; color:var(--slate); padding:2px 0; }
.dl-zone li::before { content:'• '; }

/* ── DIAGRAM: OARS GRID ── */
.oars-grid {
  display:grid; grid-template-columns:1fr 1fr; gap:14px;
}
.oar-card {
  border-radius:var(--r-sm);
  border:1px solid var(--border);
  overflow:hidden;
}
.oar-header {
  background:var(--green);
  padding:10px 16px;
  display:flex; align-items:center; gap:10px;
}
.oar-letter {
  width:32px; height:32px; border-radius:6px;
  background:rgba(255,255,255,0.2);
  display:flex; align-items:center; justify-content:center;
  font-size:16px; font-weight:800; color:#fff;
}
.oar-name { font-size:13px; font-weight:600; color:#fff; }
.oar-body { padding:12px 16px; background:var(--white); }
.oar-desc { font-size:12px; color:var(--slate); margin-bottom:8px; }
.oar-example {
  font-size:11.5px; font-style:italic; color:var(--green-mid);
  background:var(--green-xpale); border-radius:6px;
  padding:7px 10px; line-height:1.45;
}

/* ── DIAGRAM: 4-QUADRANT ── */
.quadrant-grid {
  display:grid; grid-template-columns:1fr 1fr; gap:3px;
  border-radius:var(--r); overflow:hidden;
  border:1px solid var(--border);
}
.quad-cell {
  padding:20px; background:var(--white); text-align:center;
}
.quad-cell:hover { background:var(--green-xpale); }
.quad-icon { font-size:28px; margin-bottom:8px; }
.quad-title {
  font-size:13px; font-weight:700; color:var(--navy); margin-bottom:6px;
}
.quad-desc { font-size:12px; color:var(--slate); line-height:1.5; }

/* ── DIAGRAM: MISCONCEPTIONS ── */
.misconception-grid {
  display:grid; grid-template-columns:1fr 1fr; gap:14px;
}
.mis-card {
  border-radius:var(--r-sm); padding:18px;
  border:1px solid var(--border); background:var(--white);
  position:relative; overflow:hidden;
}
.mis-card::before {
  content:''; position:absolute; top:0; left:0;
  width:100%; height:3px;
}
.mis-card.gap::before { background:#3B82F6; }
.mis-card.grain::before { background:#F59E0B; }
.mis-card.castle::before { background:#EF4444; }
.mis-card.stone::before { background:#8B5CF6; }
.mis-label {
  font-size:10px; font-weight:700; letter-spacing:0.1em;
  text-transform:uppercase; margin-bottom:4px;
}
.mis-card.gap .mis-label { color:#3B82F6; }
.mis-card.grain .mis-label { color:#F59E0B; }
.mis-card.castle .mis-label { color:#EF4444; }
.mis-card.stone .mis-label { color:#8B5CF6; }
.mis-title { font-size:14px; font-weight:700; color:var(--navy); margin-bottom:8px; }
.mis-desc { font-size:12.5px; color:var(--slate); line-height:1.55; }

/* ── DIAGRAM: SUSTAINABILITY MONITOR ── */
.monitor-card {
  background:var(--white); border-radius:var(--r);
  border:1px solid var(--border); padding:28px;
  box-shadow:var(--card-shadow);
}
.monitor-title {
  font-size:13px; font-weight:700; color:var(--navy);
  margin-bottom:20px;
}
.monitor-row {
  display:flex; align-items:center; gap:12px; margin-bottom:14px;
}
.monitor-label {
  font-size:12px; font-weight:500; color:var(--body);
  width:80px; flex-shrink:0;
}
.monitor-track {
  flex:1; height:10px; background:#F1F5F9;
  border-radius:5px; overflow:hidden;
}
.monitor-fill {
  height:100%; border-radius:5px;
  background:linear-gradient(90deg, var(--green-mid), var(--green));
  transition:width 0.4s;
}
.monitor-fill.amber { background:linear-gradient(90deg, #FBBF24, #F59E0B); }
.monitor-fill.red { background:linear-gradient(90deg, #F87171, #EF4444); }
.monitor-score {
  font-size:12px; font-weight:700; color:var(--navy); width:26px; text-align:right;
}

/* ── DIAGRAM: BURNOUT PROGRESSION ── */
.burnout-bar {
  background:linear-gradient(90deg, #D1FAE5 0%, #FEF3C7 40%, #FEE2E2 75%, #FECACA 100%);
  border-radius:8px; height:28px; position:relative; margin:20px 0;
}
.burnout-labels {
  display:flex; justify-content:space-between;
  font-size:11px; font-weight:600; margin-top:8px;
}
.burnout-markers {
  position:absolute; top:0; left:0; right:0; bottom:0;
  display:flex;
}
.burnout-zone {
  flex:1; border-right:1px solid rgba(255,255,255,0.6);
  display:flex; align-items:center; justify-content:center;
  font-size:9.5px; font-weight:600; color:rgba(0,0,0,0.45);
}
.burnout-zone:last-child { border-right:none; }

/* ── DIAGRAM: PEO MODEL ── */
.peo-diagram {
  display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px;
}
.peo-card {
  border-radius:var(--r-sm); padding:20px; text-align:center;
  border:2px solid transparent; transition:all 0.2s;
}
.peo-card:hover { transform:translateY(-2px); }
.peo-letter {
  font-size:40px; font-weight:800; line-height:1;
  margin-bottom:4px;
}
.peo-card.person { background:#E8F5F0; border-color:#A7D7CC; }
.peo-card.person .peo-letter { color:var(--green); }
.peo-card.env { background:#FFF8EC; border-color:#F5D08A; }
.peo-card.env .peo-letter { color:#B07820; }
.peo-card.occ { background:#EEF2FF; border-color:#BFCBFE; }
.peo-card.occ .peo-letter { color:#4F46E5; }
.peo-name { font-size:12px; font-weight:700; color:var(--navy); margin-bottom:8px; }
.peo-items { list-style:none; font-size:11.5px; color:var(--slate); text-align:left; }
.peo-items li { padding:2px 0; }
.peo-items li::before { content:'· '; }

/* ── DIAGRAM: DRIVER PYRAMID ── */
.driver-pyramid {
  display:flex; flex-direction:column; gap:4px; align-items:center;
  padding:20px;
}
.pyramid-row {
  border-radius:6px; display:flex; align-items:center;
  justify-content:center; gap:8px;
  font-weight:600; color:#fff; transition:transform 0.2s;
}
.pyramid-row:hover { transform:scaleX(1.02); }
.pyramid-row.primary   { width:60%; background:var(--green); padding:14px; font-size:14px; }
.pyramid-row.secondary { width:80%; background:var(--sage); padding:12px; font-size:13px; }
.pyramid-row.background{ width:100%; background:#CBD5E1; color:var(--slate); padding:10px; font-size:12px; }
.pyramid-label { font-size:10px; font-weight:400; opacity:0.8; }

/* ── DIAGRAM: DECISION TREE ── */
.decision-tree {
  background:var(--white); border-radius:var(--r);
  border:1px solid var(--border); padding:28px;
}
.dt-center {
  text-align:center; margin-bottom:24px;
}
.dt-node {
  display:inline-flex; align-items:center; justify-content:center;
  padding:10px 20px; border-radius:8px;
  font-size:13px; font-weight:600;
}
.dt-node.problem { background:var(--navy); color:#fff; }
.dt-arrows {
  display:flex; justify-content:center; gap:40px;
  margin-bottom:20px; position:relative;
}
.dt-arrows::before {
  content:''; position:absolute;
  top:-12px; left:50%; transform:translateX(-50%);
  width:1px; height:12px; background:var(--border);
}
.dt-branch {
  display:flex; flex-direction:column; align-items:center; gap:8px;
  flex:1;
}
.dt-q {
