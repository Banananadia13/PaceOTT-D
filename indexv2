<script>
const STORAGE_KEY = 'pace_health_ot_m1_v3';
let state = { completed: {}, visited: {}, notes: '' };

function loadState() {
  try {
    const s = localStorage.getItem(STORAGE_KEY);
    if (s) { const p = JSON.parse(s); Object.assign(state, p); }
  } catch(e) {}
  const ta = document.getElementById('global-notes');
  if (ta && state.notes) ta.value = state.notes;
  updateUI();
}

function saveState() {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch(e) {}
}

function saveNotes() {
  state.notes = document.getElementById('global-notes').value;
  saveState();
}

function showPage(id) {
  document.querySelectorAll('.page-view').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
  const pg = document.getElementById('page-' + id);
  const tb = document.getElementById('tab-' + id);
  if (pg) { pg.classList.add('active'); window.scrollTo(0,0); }
  if (tb) tb.classList.add('active');
  if (id.startsWith('ws')) { state.visited[id] = true; saveState(); updateUI(); }
}

function toggleComplete(wsId) {
  state.completed[wsId] = !state.completed[wsId];
  saveState();
  updateUI();
}

function updateUI() {
  const ids = ['ws1','ws2','ws3','ws4','ws5','ws6'];
  let done = 0;
  ids.forEach(id => {
    const isCompleted = !!state.completed[id];
    const isVisited   = !!state.visited[id];
    if (isCompleted) done++;

    const d = document.getElementById('done-' + id);
    if (d) d.textContent = isCompleted ? ' ✓' : '';

    const card  = document.getElementById('wsp-card-' + id);
    const badge = document.getElementById('wsp-badge-' + id);
    const check = document.getElementById('wsp-check-' + id);
    if (card) {
      card.classList.remove('completed','in-progress');
      if (isCompleted) card.classList.add('completed');
      else if (isVisited) card.classList.add('in-progress');
    }
    if (badge) {
      if (isCompleted)    { badge.textContent='Completed'; badge.className='wsp-status-badge done'; }
      else if (isVisited) { badge.textContent='In Progress'; badge.className='wsp-status-badge inprog'; }
      else                { badge.textContent='Not Started'; badge.className='wsp-status-badge todo'; }
    }
    if (check) check.classList.toggle('checked', isCompleted);

    const btn = document.getElementById('wph-btn-' + id);
    if (btn) {
      if (isCompleted) { btn.textContent = '✓ Completed'; btn.className = 'wph-btn complete-no'; }
      else             { btn.textContent = 'Mark Complete ✓'; btn.className = 'wph-btn complete-yes'; }
    }
  });

  const pct = Math.round((done/6)*100);
  const fill = document.getElementById('po-fill');
  const pctEl = document.getElementById('po-pct');
  const sub = document.getElementById('po-subtitle');
  if (fill) fill.style.width = pct + '%';
  if (pctEl) pctEl.textContent = pct + '%';
  if (sub) sub.textContent = done + ' of 6 workshops completed';
}

loadState();
</script>
